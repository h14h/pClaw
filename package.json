{
  "name": "pclaw",
  "version": "0.1.0",
  "description": "A small personal assistant you text on Discord",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pclaw": "node src/main.ts",
    "start": "node src/main.ts start",
    "setup": "node src/main.ts setup",
    "chat": "node src/main.ts chat",
    "search-bench": "node src/search-bench.ts",
    "evals": "node src/evals.ts",
    "profiles": "node src/profile-cli.ts",
    "decisions": "node src/decision-report.ts",
    "decisions:replay": "node src/decision-replay.ts",
    "test": "PCLAW_HOME=$(mktemp -d) node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "prose-lab": "node src/prose-lab/lab.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-durable": "^1.5.2",
    "@earendil-works/pi-schema": "^1.5.2",
    "discord.js": "^14.27.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^7.0.2"
  }
}
