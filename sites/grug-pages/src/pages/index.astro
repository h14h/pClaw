---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageIndex, { type PageListItem } from "@components/PageIndex.svelte";
import { formatDate, normalizePageSlug, withBase } from "@lib/urls";

const entries = await getCollection("pages");

const pages: PageListItem[] = entries
  .map((entry) => {
    const slug = normalizePageSlug(entry.id);
    return {
      slug,
      title: entry.data.title,
      subtitle: entry.data.subtitle,
      date: entry.data.date,
      formattedDate: formatDate(entry.data.date),
      updated: entry.data.updated,
      summary: entry.data.summary,
      tags: entry.data.tags ?? [],
      href: withBase(`/${slug}/`),
    };
  })
  .sort((a, b) => {
    const dateCmp = (b.updated ?? b.date).localeCompare(a.updated ?? a.date);
    if (dateCmp !== 0) return dateCmp;
    return a.title.localeCompare(b.title);
  });
---

<BaseLayout
  title="Grug Pages"
  description="Personal research notes, comparisons, guides, and interactive tools."
  isHome
  ogType="website"
  ogImagePath="/og/index.png"
  canonicalPath="/"
>
  {/* Filled by the pages server with each page's /p/ share link (slug → URL), for the shelf's "Copy share link". */}
  <script type="application/json" data-share-links is:inline set:html={"{}"} />
  <PageIndex client:load pages={pages} />
</BaseLayout>
