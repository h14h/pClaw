---
import "@styles/global.css";
import geistFontUrl from "../assets/fonts/geist-latin-wght-normal.woff2?url";
import GrugMark from "@components/GrugMark.astro";
import { absoluteUrl, withBase } from "@lib/urls";
import tableHeadingSource from "../../lib/table-heading.mjs?raw";

interface Props {
  title: string;
  description?: string;
  isHome?: boolean;
  ogType?: "website" | "article";
  ogImagePath?: string;
  canonicalPath?: string;
}

const {
  title,
  description = "Personal research notes and interactive pages.",
  isHome = false,
  ogType = isHome ? "website" : "article",
  ogImagePath = "/og/index.png",
  canonicalPath,
} = Astro.props;

const homeHref = withBase("/");
const faviconSvgHref = withBase("/favicon.svg");
const faviconPngHref = withBase("/favicon-32x32.png");
const appleTouchIconHref = withBase("/apple-touch-icon.png");
const canonicalUrl = canonicalPath
  ? absoluteUrl(canonicalPath, Astro.site)
  : new URL(Astro.url.pathname, Astro.site ?? "https://grug.h14h.com").toString();
const ogImageUrl = absoluteUrl(ogImagePath, Astro.site);

// Shared, tested heading planner inlined as a classic-script global for the table script below
const tableHeadingScript = `const grugTableHeading = (() => {\n${tableHeadingSource.replace(/^export /gm, "")}\nreturn { planTableHeading, splitKeepingHyphenated };\n})();`;
---

<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{isHome ? title : `${title} — grug pages`}</title>
    <link rel="icon" href={faviconSvgHref} type="image/svg+xml" />
    <link rel="icon" href={faviconPngHref} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={appleTouchIconHref} sizes="180x180" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Grug Pages" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="preload" as="font" type="font/woff2" href={geistFontUrl} crossorigin />
    <script is:inline>
      (() => {
        // Storage can be off (private modes, blocked site data); the system theme still decides first paint.
        let stored = null;
        try {
          stored = localStorage.getItem("grug-theme");
        } catch {}
        const dark =
          stored === "dark" ||
          (stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body id="top" class="min-h-dvh bg-paper font-sans text-stone-900 selection:bg-accent/15 dark:bg-obsidian dark:text-stone-200 dark:selection:bg-accent-dark/20">
    <a
      href="#main-content"
      data-jump
      class="print-hide sr-only z-50 rounded-md bg-paper px-4 py-3 text-base/6 font-medium text-stone-900 shadow-sm ring-1 ring-stone-950/10 focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:outline-2 focus:outline-offset-2 focus:outline-accent dark:bg-obsidian dark:text-stone-100 dark:ring-white/15 dark:focus:outline-accent-dark"
    >
      Skip to content
    </a>
    <div class="isolate">
      <header class="print-hide border-b border-stone-950/8 dark:border-white/8">
        <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-5 py-3.5 sm:px-8">
          <a
            href={homeHref}
            data-owner-nav="home"
            aria-label="Homepage"
            class="inline-flex shrink-0 items-center gap-2.5 py-1 text-base/6 pointer-coarse:-my-2 pointer-coarse:min-h-12 font-medium tracking-tight text-stone-900 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:text-sm/5 dark:text-stone-100 dark:hover:text-accent-dark dark:focus-visible:outline-accent-dark"
          >
            <GrugMark class="size-6 shrink-0" />
            <span>grug pages</span>
          </a>
          <nav aria-label="Site navigation" class="flex min-h-10 shrink-0 items-center gap-5 text-base/6 sm:min-h-9 sm:text-sm/5">
            {!isHome && (
              <a
                href={homeHref}
                data-owner-nav="all"
                class="px-1 py-2 text-stone-600 pointer-coarse:-my-1 pointer-coarse:inline-flex pointer-coarse:min-h-12 pointer-coarse:items-center hover:text-stone-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:text-stone-400 dark:hover:text-stone-100 dark:focus-visible:outline-accent-dark"
              >
                All pages
              </a>
            )}
            <button
              id="theme-toggle"
              type="button"
              aria-label="Toggle color theme"
              class="group -m-2 inline-flex size-12 items-center justify-center focus-visible:outline-none"
            >
              <!-- 48×48 hit area; -m-2 keeps its layout footprint at the 32×32 chip, so the header doesn't move -->
              <span
                class="inline-flex size-8 items-center justify-center rounded-md group-hover:bg-stone-950/5 group-focus-visible:outline-2 group-focus-visible:outline-offset-2 group-focus-visible:outline-accent dark:group-hover:bg-white/8 dark:group-focus-visible:outline-accent-dark"
                aria-hidden="true"
              >
                <!-- Heroicons Micro: Moon (shown in light mode) -->
                <svg
                  viewBox="0 0 16 16"
                  aria-hidden="true"
                  class="size-4 shrink-0 fill-stone-600 group-hover:fill-stone-900 dark:hidden dark:fill-stone-400 dark:group-hover:fill-stone-100"
                >
                  <path d="M14.438 10.148c.19-.425-.321-.787-.748-.601A5.5 5.5 0 0 1 6.453 2.31c.186-.427-.176-.938-.6-.748a6.501 6.501 0 1 0 8.585 8.586Z" />
                </svg>
                <!-- Heroicons Micro: Sun (shown in dark mode) -->
                <svg
                  viewBox="0 0 16 16"
                  aria-hidden="true"
                  class="size-4 shrink-0 fill-stone-600 group-hover:fill-stone-900 not-dark:hidden dark:fill-stone-400 dark:group-hover:fill-stone-100"
                >
                  <path d="M8 1a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 8 1ZM10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0ZM12.95 4.11a.75.75 0 1 0-1.06-1.06l-1.062 1.06a.75.75 0 0 0 1.061 1.062l1.06-1.061ZM15 8a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 15 8ZM11.89 12.95a.75.75 0 0 0 1.06-1.06l-1.06-1.062a.75.75 0 0 0-1.062 1.061l1.061 1.06ZM8 12a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 8 12ZM5.172 11.89a.75.75 0 0 0-1.061-1.062L3.05 11.89a.75.75 0 1 0 1.06 1.06l1.062-1.06ZM4 8a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 4 8ZM4.11 5.172A.75.75 0 0 0 5.173 4.11L4.11 3.05a.75.75 0 1 0-1.06 1.06l1.06 1.062Z" />
                </svg>
              </span>
            </button>
          </nav>
        </div>
      </header>

      <main id="main-content" tabindex="-1" class="mx-auto max-w-3xl px-5 pt-8 pb-16 outline-none sm:px-8 sm:pt-12 sm:pb-24">
        <slot />
      </main>
    </div>

    {isHome && (
      <script is:inline define:vars={{ shelfHref: homeHref }}>
        // The owner opened their shelf: remember it, so their shared links can still lead back here.
        try {
          localStorage.setItem("grug-shelf", shelfHref);
        } catch {}
      </script>
    )}
    <script is:inline>
      // Share links (/p/<token>/) arrive with owner links unlinked and hidden. Only a browser that has opened a
      // shelf gets them back, pointing at that shelf; visitors never see them.
      (() => {
        if (!document.documentElement.hasAttribute("data-grug-shared")) return;
        let shelf = null;
        try {
          shelf = localStorage.getItem("grug-shelf");
        } catch {}
        if (!shelf || !/^\/[a-z0-9]{6,24}\/$/.test(shelf)) return;
        for (const link of document.querySelectorAll("a[data-owner-nav]")) {
          link.setAttribute("href", shelf);
          link.removeAttribute("hidden");
        }
      })();
    </script>
    <script is:inline>
      // In-page jumps (skip link, Contents, Back to top) take keyboard focus along with the scroll, so Tab and screen
      // readers carry on from where the reader landed. a[data-jump="id"] focuses that element instead of the target.
      document.addEventListener("click", (event) => {
        const link = event.target instanceof Element ? event.target.closest("a[data-jump]") : null;
        if (!link || event.defaultPrevented) return;
        const target = document.getElementById(link.dataset.jump || decodeURIComponent(link.hash.slice(1)));
        if (!target) return;
        setTimeout(() => {
          if (!target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
          target.focus({ preventScroll: true });
        });
      });
    </script>
    <p id="share-copy-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>
    <script is:inline>
      // "Copy share link" (links the pages server fills in on the owner's address, a[data-share-copy] pointing at
      // /p/<token>/). Copies the full share URL: the Clipboard API, then a hidden-textarea copy for browsers that
      // refuse it (some in-app browsers), then a selectable field as a last resort. "Copied" for 2s, announced.
      (() => {
        const status = document.getElementById("share-copy-status");
        const legacyCopy = (text) => {
          // The copy needs a selected field to focus; focus then goes back to whatever had it (the button, by
          // keyboard), so a successful copy never strands keyboard users.
          const before = document.activeElement;
          const area = document.createElement("textarea");
          area.value = text;
          area.setAttribute("readonly", "");
          area.style.cssText = "position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;pointer-events:none";
          document.body.append(area);
          area.focus({ preventScroll: true });
          area.select();
          area.setSelectionRange(0, text.length);
          let ok = false;
          try {
            ok = document.execCommand("copy");
          } catch {}
          area.remove();
          if (before instanceof HTMLElement && before !== document.body) before.focus({ preventScroll: true });
          return ok;
        };
        // Last resort: the link in a field on its own full-width line under the button's row, fully selected,
        // with a visible instruction. 16px text, so iOS web views don't zoom in when it takes focus.
        const showField = (link, url) => {
          let box = link.nextElementSibling;
          if (!box || !box.matches("[data-share-fallback]")) {
            box = document.createElement("label");
            box.dataset.shareFallback = "";
            box.className = "share-copy-fallback";
            const text = document.createElement("span");
            text.textContent = "Copy this link:";
            const input = document.createElement("input");
            input.type = "text";
            input.readOnly = true;
            input.dataset.shareField = "";
            input.className = "share-copy-field";
            box.append(text, input);
            link.after(box);
          }
          const field = box.querySelector("input");
          field.value = url;
          field.focus({ preventScroll: true });
          field.select();
          field.setSelectionRange(0, url.length);
          // If the instruction or the field landed off screen (a button at the bottom edge), bring them into view at
          // once; an instant jump also respects reduced motion. Focus and selection stay.
          const box_ = box.getBoundingClientRect();
          if (box_.top < 0 || box_.bottom > window.innerHeight) box.scrollIntoView({ block: "nearest", behavior: "instant" });
          if (status) status.textContent = "Copy the share link from the field below";
        };
        const timers = new WeakMap();
        document.addEventListener("click", (event) => {
          if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const link = event.target instanceof Element ? event.target.closest("a[data-share-copy]") : null;
          if (!link) return;
          const href = link.getAttribute("href");
          if (!href || !href.startsWith("/p/")) return;
          event.preventDefault();
          const url = new URL(href, location.href).href;
          const copied = () => {
            clearTimeout(timers.get(link));
            link.setAttribute("data-copied", "");
            if (status) {
              status.textContent = "";
              status.textContent = "Share link copied";
            }
            timers.set(link, setTimeout(() => link.removeAttribute("data-copied"), 2000));
          };
          // Without the async API, copy synchronously while the tap still counts as a user gesture.
          if (!navigator.clipboard || !window.isSecureContext) {
            if (legacyCopy(url)) copied();
            else showField(link, url);
            return;
          }
          navigator.clipboard.writeText(url).then(copied, () => {
            if (legacyCopy(url)) copied();
            else showField(link, url);
          });
        });
      })();
    </script>
    <script is:inline set:html={tableHeadingScript} />
    <script is:inline>
      (() => {
        const btn = document.getElementById("theme-toggle");
        if (!btn) return;
        const sync = () => {
          const isDark = document.documentElement.classList.contains("dark");
          btn.setAttribute("aria-pressed", String(isDark));
          btn.setAttribute("aria-label", isDark ? "Switch to light mode" : "Switch to dark mode");
        };
        sync();
        btn.addEventListener("click", () => {
          const nextDark = !document.documentElement.classList.contains("dark");
          document.documentElement.classList.toggle("dark", nextDark);
          try {
            localStorage.setItem("grug-theme", nextDark ? "dark" : "light");
          } catch {}
          sync();
        });
        const mq = window.matchMedia("(prefers-color-scheme: dark)");
        mq.addEventListener("change", (event) => {
          try {
            if (localStorage.getItem("grug-theme")) return;
          } catch {}
          document.documentElement.classList.toggle("dark", event.matches);
          sync();
        });
      })();

      (() => {
        const scrollers = Array.from(document.querySelectorAll(".table-scroll"));
        if (scrollers.length === 0) return;

        const compactNumRe =
          /^[~$€£¥<>≤≥±+\-]?\d[\d,.\s/–—\-×x%$€£¥kKmMbB]*(?:\s*(?:yr|mo|ft|mi|ac|Mbps|Gbps|sqft|unit))?$/i;
        const rankHeaderRe = /^(#|rank|no\.?|pos|step)$/i;
        const rankCellRe = /^(?:#?\d{1,3}\.?|n\/a|—|–|-)$/i;

        const findNearestHeading = (el) => {
          const root = el.closest("article, main") || document.body;
          const headings = Array.from(root.querySelectorAll("h2, h3, h4"));
          let best = "";
          for (const h of headings) {
            const rel = h.compareDocumentPosition(el);
            if (rel & Node.DOCUMENT_POSITION_FOLLOWING) {
              const txt = (h.textContent || "").replace(/\s+/g, " ").trim();
              if (txt) best = txt;
            } else {
              break;
            }
          }
          return best;
        };

        // Swap a body <td> for <th scope="row">, keeping its attributes and children
        const toRowHeader = (cell) => {
          if (!cell) return;
          if (cell.tagName === "TH") {
            if (!cell.hasAttribute("scope")) cell.setAttribute("scope", "row");
            return;
          }
          const th = document.createElement("th");
          for (const attr of Array.from(cell.attributes)) th.setAttribute(attr.name, attr.value);
          while (cell.firstChild) th.appendChild(cell.firstChild);
          th.setAttribute("scope", "row");
          cell.replaceWith(th);
        };

        // Header cells: planned by lib/table-heading.mjs (linear, inlined above). Short labels stay
        // on one line, mid-length ones wrap only between two word groups, long ones only keep
        // hyphenated words whole and let CSS balance the lines.
        const appendRuns = (parent, runs, before) => {
          for (const run of runs) {
            let node;
            if (run.nowrap) {
              node = document.createElement("span");
              node.className = "th-nowrap";
              node.textContent = run.text;
            } else {
              node = document.createTextNode(run.text);
            }
            parent.insertBefore(node, before);
          }
        };
        const fitHeaderCell = (th) => {
          const plainText = Array.from(th.childNodes).every((node) => node.nodeType === Node.TEXT_NODE);
          if (plainText) {
            const plan = grugTableHeading.planTableHeading(th.textContent || "");
            if (plan.runs.length === 0) return;
            if (plan.oneLine) th.dataset.nowrap = "true";
            th.textContent = "";
            appendRuns(th, plan.runs, null);
            return;
          }
          // Mixed markup: keep each hyphenated word whole, one text node at a time
          const walker = document.createTreeWalker(th, NodeFilter.SHOW_TEXT);
          const textNodes = [];
          while (walker.nextNode()) textNodes.push(walker.currentNode);
          for (const node of textNodes) {
            const runs = grugTableHeading.splitKeepingHyphenated(node.nodeValue || "");
            if (!runs.some((run) => run.nowrap)) continue;
            appendRuns(node.parentNode, runs, node);
            node.remove();
          }
        };

        const labelCounts = new Map();
        const regionLabels = new WeakMap();

        scrollers.forEach((scroller, index) => {
          const table = scroller.querySelector("table");
          const block = scroller.closest(".table-block") || scroller;

          // Unique accessible name per scrollable table region
          const captionText = (table?.querySelector("caption")?.textContent || "")
            .replace(/\s+/g, " ")
            .trim();
          const headingText = captionText || findNearestHeading(block);
          const baseLabel = headingText
            ? `${headingText} — scrollable table`
            : `Scrollable data table ${index + 1}`;
          const count = (labelCounts.get(baseLabel) || 0) + 1;
          labelCounts.set(baseLabel, count);
          regionLabels.set(scroller, count === 1 ? baseLabel : `${baseLabel} (${count})`);

          if (!table) return;

          const headerCells = Array.from(table.querySelectorAll("thead tr:first-child > th"));
          const bodyRows = Array.from(table.querySelectorAll("tbody > tr"));
          const colCount = headerCells.length || (bodyRows[0]?.children.length ?? 0);

          // Smart rank-column detection: pin col 1 + col 2 when col 1 is a short rank/index column
          const col1Header = (headerCells[0]?.textContent || "").trim();
          const col1Values = bodyRows
            .map((row) => (row.children[0]?.textContent || "").trim())
            .filter(Boolean);
          const isRankCol =
            colCount >= 3 &&
            (rankHeaderRe.test(col1Header) ||
              (col1Values.length > 0 &&
                col1Values.some((val) => /\d/.test(val)) &&
                col1Values.every((val) => val.length <= 4 && rankCellRe.test(val))));

          const entityColIndex = isRankCol ? 1 : 0;
          if (isRankCol) {
            table.setAttribute("data-sticky-entity", "2");
          }

          let maxCellLen = 0;
          for (const row of bodyRows) {
            for (const cell of Array.from(row.children)) {
              const text = (cell.textContent || "").trim();
              if (text.length > maxCellLen) maxCellLen = text.length;
              if (text.length > 0 && text.length <= 18 && compactNumRe.test(text)) {
                cell.dataset.compactNum = "true";
              }
            }
            // Identity cell becomes a real row header so assistive tech exposes it as `rowheader`
            toRowHeader(row.children[entityColIndex]);
          }

          performance.mark("grug:table-headings:start");
          for (const th of headerCells) fitHeaderCell(th);
          performance.measure("grug:table-headings", "grug:table-headings:start");

          // Only prose-heavy 3-column tables get a mobile min-width so compact 3-col tables fit naturally
          if (colCount === 3 && maxCellLen > 90) {
            table.setAttribute("data-wide-prose", "true");
          }
          // Short-cell tables (numbers, labels) never get a forced mobile floor; they scroll only if content truly overflows
          if (maxCellLen > 0 && maxCellLen <= 24) {
            table.setAttribute("data-compact", "true");
          }
        });

        const setAttr = (el, name, val) => {
          if (!el) return;
          if (val === null) {
            if (el.hasAttribute(name)) el.removeAttribute(name);
          } else if (el.getAttribute(name) !== val) {
            el.setAttribute(name, val);
          }
        };

        const syncStickyCol1Width = (scroller, scrollable) => {
          const wrap = scroller.closest(".table-wrap");
          const table = scroller.querySelector("table");
          if (!scrollable || !table || table.getAttribute("data-sticky-entity") !== "2") {
            if (wrap) wrap.style.removeProperty("--sticky-col1-w");
            scroller.style.removeProperty("--sticky-col1-w");
            return;
          }
          const col1 =
            table.querySelector("thead th:first-child") ||
            table.querySelector("tbody tr > :first-child");
          if (!col1) return;
          // Keep the fractional width so col 2 pins exactly flush against col 1
          const widthPx = Math.round(col1.getBoundingClientRect().width * 1000) / 1000;
          if (widthPx > 0) {
            const val = `${widthPx}px`;
            if (wrap && wrap.style.getPropertyValue("--sticky-col1-w") !== val) {
              wrap.style.setProperty("--sticky-col1-w", val);
            }
            if (scroller.style.getPropertyValue("--sticky-col1-w") !== val) {
              scroller.style.setProperty("--sticky-col1-w", val);
            }
          }
        };

        const syncScrollEdges = (scroller) => {
          const block = scroller.closest(".table-block");
          const maxScroll = Math.max(0, scroller.scrollWidth - scroller.clientWidth);
          const scrollable = maxScroll > 2;

          if (!scrollable) {
            setAttr(scroller, "data-scrollable", null);
            setAttr(scroller, "data-scrolled-start", null);
            setAttr(scroller, "data-scrolled-end", null);
            setAttr(scroller, "tabindex", null);
            setAttr(scroller, "role", null);
            setAttr(scroller, "aria-label", null);
            setAttr(block, "data-scrollable", null);
            setAttr(block, "data-scrolled-start", null);
            setAttr(block, "data-scrolled-end", null);
            syncStickyCol1Width(scroller, false);
            return;
          }

          const atStart = scroller.scrollLeft <= 2;
          const atEnd = scroller.scrollLeft >= maxScroll - 2;
          setAttr(scroller, "data-scrollable", "true");
          setAttr(scroller, "data-scrolled-start", String(atStart));
          setAttr(scroller, "data-scrolled-end", String(atEnd));
          setAttr(scroller, "tabindex", "0");
          setAttr(scroller, "role", "region");
          setAttr(scroller, "aria-label", regionLabels.get(scroller) || "Scrollable data table");
          setAttr(block, "data-scrollable", "true");
          setAttr(block, "data-scrolled-start", String(atStart));
          setAttr(block, "data-scrolled-end", String(atEnd));
          syncStickyCol1Width(scroller, true);
        };

        const syncAll = () => {
          for (const scroller of scrollers) syncScrollEdges(scroller);
        };

        for (const scroller of scrollers) {
          let rafId = 0;
          scroller.addEventListener(
            "scroll",
            () => {
              if (rafId) return;
              rafId = requestAnimationFrame(() => {
                rafId = 0;
                syncScrollEdges(scroller);
              });
            },
            { passive: true },
          );
          scroller.addEventListener("keydown", (event) => {
            if (scroller.getAttribute("data-scrollable") !== "true") return;
            if (event.metaKey || event.ctrlKey || event.altKey) return;
            if (event.key === "ArrowRight") {
              event.preventDefault();
              scroller.scrollLeft += 80;
              syncScrollEdges(scroller);
            } else if (event.key === "ArrowLeft") {
              event.preventDefault();
              scroller.scrollLeft -= 80;
              syncScrollEdges(scroller);
            } else if (event.key === "Home") {
              event.preventDefault();
              scroller.scrollLeft = 0;
              syncScrollEdges(scroller);
            } else if (event.key === "End") {
              event.preventDefault();
              scroller.scrollLeft = scroller.scrollWidth;
              syncScrollEdges(scroller);
            }
          });
        }

        if (typeof ResizeObserver !== "undefined") {
          const ro = new ResizeObserver(syncAll);
          for (const scroller of scrollers) {
            ro.observe(scroller);
            const table = scroller.querySelector("table");
            if (table) ro.observe(table);
          }
        }
        window.addEventListener("resize", syncAll, { passive: true });
        syncAll();
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(syncAll);
        }
      })();
    </script>
  </body>
</html>
