---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import { formatDate, withBase } from "@lib/urls";

interface Props {
  title: string;
  subtitle?: string;
  date: string;
  updated?: string;
  summary: string;
  tags?: string[];
  headings?: MarkdownHeading[];
}

const { title, subtitle, date, updated, summary, tags = [], headings = [] } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2);
const showToc = tocHeadings.length >= 4;
const homeHref = withBase("/");
---

<BaseLayout title={title} description={summary} breadcrumb={title}>
  <header class="pb-7 border-b border-stone-950/8 dark:border-white/8">
    <h1 class="text-2xl font-semibold tracking-tight text-pretty text-stone-900 sm:text-3xl dark:text-zinc-100">
      {title}
    </h1>
    {subtitle && (
      <p class="mt-3 text-lg/7 text-pretty text-stone-600 sm:text-base/7 dark:text-zinc-400">
        {subtitle}
      </p>
    )}
    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-base/6 text-stone-500 sm:text-sm/5 dark:text-zinc-400">
      <time datetime={date} class="tabular-nums">{formatDate(date)}</time>
      {updated && updated !== date && (
        <>
          <span aria-hidden="true" class="text-stone-300 dark:text-zinc-700">&middot;</span>
          <span class="tabular-nums">Updated <time datetime={updated}>{formatDate(updated)}</time></span>
        </>
      )}
      {tags.length > 0 && (
        <ul role="list" class="flex flex-wrap items-center gap-1.5">
          {tags.map((tag) => (
            <li class="rounded-md bg-stone-950/5 px-2 py-0.5 text-stone-700 dark:bg-white/8 dark:text-zinc-300">
              {tag}
            </li>
          ))}
        </ul>
      )}
    </div>
  </header>

  {showToc && (
    <nav aria-label="Contents" class="mt-6 border-b border-stone-950/8 pb-6 dark:border-white/8">
      <p class="font-mono text-sm uppercase tracking-wide text-stone-500 dark:text-zinc-400">
        Contents
      </p>
      <ol role="list" class="mt-3 grid grid-cols-1 gap-x-6 gap-y-1.5 text-base/6 sm:grid-cols-2 sm:text-sm/6">
        {tocHeadings.map((heading) => (
          <li class="min-w-0">
            <a
              href={`#${heading.slug}`}
              class="text-stone-700 hover:text-accent dark:text-zinc-300 dark:hover:text-accent-dark"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )}

  <article class="prose mt-8 sm:mt-10">
    <slot />
  </article>

  <footer class="print-hide mt-14 border-t border-stone-950/8 pt-6 text-base/6 sm:text-sm/5 dark:border-white/8">
    <a
      href={homeHref}
      class="font-normal text-stone-600 hover:text-stone-900 dark:text-zinc-400 dark:hover:text-zinc-100"
    >
      &larr; All pages
    </a>
  </footer>
</BaseLayout>
