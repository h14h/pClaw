---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import { formatDate, withBase } from "@lib/urls";
import lightboxMath from "../../lib/lightbox.mjs?raw";
import lightboxClient from "../../lib/lightbox-client.js?raw";

interface Props {
  slug?: string;
  title: string;
  subtitle?: string;
  date: string;
  updated?: string;
  summary: string;
  tags?: string[];
  headings?: MarkdownHeading[];
}

const { slug, title, subtitle, date, updated, summary, tags = [], headings = [] } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2);
const showToc = tocHeadings.length >= 4;
const homeHref = withBase("/");
const ogImagePath = slug ? `/og/${slug}.png` : "/og/index.png";
const canonicalPath = slug ? `/${slug}/` : undefined;
// The photo viewer: tested zoom/pan math plus the page wiring, as one classic inline script per page.
// Comments are dropped from the inlined copy (the sources keep them).
const stripComments = (source: string) => source.replace(/\/\*\*[\s\S]*?\*\//g, "").replace(/^\s*\/\/.*\n/gm, "");
const lightboxScript = `(() => {\n${stripComments(lightboxMath.replace(/^export /gm, ""))}\n${stripComments(lightboxClient)}\n})();`;
---

<BaseLayout
  title={title}
  description={summary}
  ogType="article"
  ogImagePath={ogImagePath}
  canonicalPath={canonicalPath}
>
  <header class="border-b border-stone-950/8 pb-7 dark:border-white/8">
    <h1 class="text-2xl font-semibold tracking-tight text-pretty text-stone-900 sm:text-3xl dark:text-stone-100">
      {title}
    </h1>
    {subtitle && (
      <p class="mt-3 text-lg/7 text-pretty text-stone-600 dark:text-stone-400">
        {subtitle}
      </p>
    )}
    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-base/6 text-stone-500 sm:text-sm/5 dark:text-stone-400">
      <time datetime={date} class="tabular-nums">{formatDate(date)}</time>
      {updated && updated !== date && (
        <>
          <span aria-hidden="true" class="text-stone-300 dark:text-stone-700">&middot;</span>
          <span class="tabular-nums">Updated <time datetime={updated}>{formatDate(updated)}</time></span>
        </>
      )}
      {tags.length > 0 && (
        <ul role="list" class="flex flex-wrap items-center gap-1.5">
          {tags.map((tag) => (
            <li class="rounded-md bg-stone-950/5 px-2 py-0.5 text-stone-700 dark:bg-white/8 dark:text-stone-300">
              {tag}
            </li>
          ))}
        </ul>
      )}
    </div>
  </header>

  {showToc && (
    <nav aria-label="Contents" class="border-b border-stone-950/8 dark:border-white/8">
      <details class="group">
        <summary class="flex min-h-12 w-full cursor-pointer list-none items-center justify-between gap-3 py-3.5 text-base/6 font-medium text-stone-700 select-none hover:text-accent focus-visible:rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:text-sm/5 dark:text-stone-300 dark:hover:text-accent-dark dark:focus-visible:outline-accent-dark [&::-webkit-details-marker]:hidden">
          <span class="flex items-center gap-2">
            <span class="font-mono text-sm uppercase tracking-wide text-stone-500 dark:text-stone-400">
              Contents
            </span>
            <span aria-hidden="true" class="text-stone-300 dark:text-stone-700">&middot;</span>
            <span class="tabular-nums text-stone-500 dark:text-stone-400">
              {tocHeadings.length} sections
            </span>
          </span>
          <svg
            viewBox="0 0 16 16"
            aria-hidden="true"
            class="size-4 shrink-0 fill-stone-500 transition-transform duration-150 group-open:rotate-90 dark:fill-stone-400"
          >
            <path
              fill-rule="evenodd"
              d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06L8.94 8 6.22 5.28a.75.75 0 0 1 0-1.06Z"
              clip-rule="evenodd"
            />
          </svg>
        </summary>
        <ol role="list" class="pt-1 pb-4 text-base/6 sm:columns-2 sm:gap-8 sm:pb-5 sm:text-sm/6">
          {tocHeadings.map((heading) => (
            <li class="break-inside-avoid">
              <a
                href={`#${heading.slug}`}
                class="-mx-2 block min-h-11 rounded-md px-2 py-2.5 text-stone-700 underline decoration-stone-950/20 underline-offset-4 hover:bg-stone-950/4 hover:text-accent hover:decoration-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:min-h-0 sm:py-1.5 dark:text-stone-300 dark:decoration-white/20 dark:hover:bg-white/6 dark:hover:text-accent-dark dark:hover:decoration-accent-dark dark:focus-visible:outline-accent-dark"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )}

  <article class="prose mt-7 sm:mt-8">
    <slot />
  </article>

  <script is:inline set:html={lightboxScript} />

  <footer class="print-hide mt-14 flex items-center justify-between gap-4 border-t border-stone-950/8 pt-6 text-base/6 sm:text-sm/5 dark:border-white/8">
    <a
      href={homeHref}
      data-owner-nav="all"
      class="py-1 font-normal text-stone-600 hover:text-stone-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:text-stone-400 dark:hover:text-stone-100 dark:focus-visible:outline-accent-dark"
    >
      &larr; All pages
    </a>
    <a
      href="#top"
      class="ml-auto py-1 font-normal text-stone-500 hover:text-stone-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:text-stone-400 dark:hover:text-stone-100 dark:focus-visible:outline-accent-dark"
    >
      Back to top &uarr;
    </a>
  </footer>
</BaseLayout>
