---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import { formatDate, withBase } from "@lib/urls";

interface Props {
  slug?: string;
  title: string;
  subtitle?: string;
  date: string;
  updated?: string;
  summary: string;
  tags?: string[];
  headings?: MarkdownHeading[];
}

const { slug, title, subtitle, date, updated, summary, tags = [], headings = [] } = Astro.props;
const homeHref = withBase("/");
const ogImagePath = slug ? `/og/${slug}.png` : "/og/index.png";
const canonicalPath = slug ? `/${slug}/` : undefined;

// The report body, rendered first so Contents can link the Sources section it actually contains.
const body = await Astro.slots.render("default");
const sourcesTitle = /<h2 id="sources-heading"[^>]*>\s*([^<]*?)\s*<\/h2>/.exec(body)?.[1];

// Contents: H2s, with each H2's H3s nested under it, then Sources. Shown once a report has 3 or more major
// destinations (H2s plus Sources) or 6 or more H2/H3 entries. Every entry focuses a visible heading: `focus` names
// it when the link's fragment is a wrapper (Sources scrolls to its section, focuses its H2).
type TocEntry = { slug: string; text: string; focus?: string; children: { slug: string; text: string }[] };
const toc: TocEntry[] = [];
for (const heading of headings) {
  if (heading.depth === 2 || (heading.depth === 3 && toc.length === 0)) {
    toc.push({ slug: heading.slug, text: heading.text, children: [] });
  } else if (heading.depth === 3) {
    toc.at(-1)!.children.push({ slug: heading.slug, text: heading.text });
  }
}
if (sourcesTitle) toc.push({ slug: "sources", text: sourcesTitle, focus: "sources-heading", children: [] });
const tocEntries = toc.reduce((count, entry) => count + 1 + entry.children.length, 0);
const showToc = toc.length >= 3 || tocEntries >= 6;
const tocLink =
  "-mx-2 flex min-h-12 items-center rounded-md px-2 py-3 underline underline-offset-4 hover:bg-stone-950/4 hover:text-accent hover:decoration-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:pointer-fine:min-h-0 sm:pointer-fine:py-1.5 dark:hover:bg-white/6 dark:hover:text-accent-dark dark:hover:decoration-accent-dark dark:focus-visible:outline-accent-dark";
const tocChild = "text-stone-600 decoration-stone-950/15 dark:text-stone-400 dark:decoration-white/15";
---

<BaseLayout
  title={title}
  description={summary}
  ogType="article"
  ogImagePath={ogImagePath}
  canonicalPath={canonicalPath}
>
  <header class="border-b border-stone-950/8 pb-5 sm:pb-7 dark:border-white/8">
    <h1 id="report-title" tabindex="-1" class="text-2xl font-semibold tracking-tight text-pretty text-stone-900 sm:text-3xl dark:text-stone-100">
      {title}
    </h1>
    {subtitle && (
      <p class="mt-3 text-lg/7 text-pretty text-stone-600 dark:text-stone-400">
        {subtitle}
      </p>
    )}
    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-base/6 text-stone-500 sm:text-sm/5 dark:text-stone-400">
      <!-- One text run, so a narrow screen wraps it at a space rather than stranding a separator -->
      <span class="tabular-nums">
        <time datetime={date}>{formatDate(date)}</time>{updated && updated !== date && (
          <>, updated <time datetime={updated}>{formatDate(updated)}</time></>
        )}
      </span>
      {slug && (
        // "Copy share link": hidden in the build; the pages server fills in this page's /p/ link on the owner's
        // address (a plain link without JS) and removes it from the share address. See ownerHtml in pages-server.ts.
        <a
          href="#share-link"
          hidden
          data-share-copy={slug}
          aria-label="Copy share link"
          class="share-copy print-hide inline-flex items-center gap-1.5 rounded-md py-1 text-stone-500 hover:text-stone-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent pointer-coarse:min-h-12 dark:text-stone-400 dark:hover:text-stone-100 dark:focus-visible:outline-accent-dark"
        >
          <svg viewBox="0 0 16 16" aria-hidden="true" class="share-copy-icon size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6.5 9.5a3 3 0 0 0 4.2 0l2-2a3 3 0 0 0-4.2-4.2l-.6.6M9.5 6.5a3 3 0 0 0-4.2 0l-2 2a3 3 0 0 0 4.2 4.2l.6-.6" />
          </svg>
          <svg viewBox="0 0 16 16" aria-hidden="true" class="share-copy-done size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3.5 8.5l3 3 6-7" />
          </svg>
          <span class="share-copy-label" aria-hidden="true">
            <span class="share-copy-idle">Copy share link</span>
            <span class="share-copy-copied" aria-hidden="true">Copied</span>
          </span>
        </a>
      )}
    </div>
    {tags.length > 0 && (
      <p class="mt-1.5 text-sm/5 text-pretty text-stone-500 dark:text-stone-400">
        <span class="sr-only">Tags: </span>{tags.join(", ")}
      </p>
    )}
  </header>

  {showToc && (
    <nav aria-label="Contents" class="border-b border-stone-950/8 dark:border-white/8">
      <details class="group">
        <summary class="flex min-h-12 w-full cursor-pointer list-none items-center justify-between gap-3 py-3.5 text-base/6 font-medium text-stone-700 select-none hover:text-accent focus-visible:rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:text-sm/5 dark:text-stone-300 dark:hover:text-accent-dark dark:focus-visible:outline-accent-dark [&::-webkit-details-marker]:hidden">
          <span class="flex items-center gap-2">
            <span class="font-mono text-sm uppercase tracking-wide text-stone-500 dark:text-stone-400">
              Contents
            </span>
            <span aria-hidden="true" class="text-stone-300 dark:text-stone-700">&middot;</span>
            <span class="tabular-nums text-stone-500 dark:text-stone-400">
              {toc.length} sections
            </span>
          </span>
          <svg
            viewBox="0 0 16 16"
            aria-hidden="true"
            class="size-4 shrink-0 fill-stone-500 group-open:rotate-90 motion-safe:transition-transform motion-safe:duration-150 dark:fill-stone-400"
          >
            <path
              fill-rule="evenodd"
              d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06L8.94 8 6.22 5.28a.75.75 0 0 1 0-1.06Z"
              clip-rule="evenodd"
            />
          </svg>
        </summary>
        <!-- Phones: the main sections first, each one's subsections behind a small disclosure. From sm: all nested. -->
        <ol role="list" class="pt-1 pb-4 text-base/6 sm:columns-2 sm:gap-8 sm:pb-5 sm:text-sm/6">
          {toc.map((entry) => (
            <li class="break-inside-avoid">
              <a
                href={`#${entry.slug}`}
                data-jump={entry.focus ?? ""}
                class={`${tocLink} text-stone-800 decoration-stone-950/20 dark:text-stone-200 dark:decoration-white/20`}
              >
                {entry.text}
              </a>
              {entry.children.length > 0 && (
                <>
                  <details class="group/sub sm:hidden">
                    <summary class="-mx-2 ml-1 flex min-h-12 cursor-pointer list-none items-center gap-2 rounded-md px-2 pl-3 text-stone-500 select-none hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:text-stone-400 dark:hover:text-accent-dark dark:focus-visible:outline-accent-dark [&::-webkit-details-marker]:hidden">
                      <svg viewBox="0 0 16 16" aria-hidden="true" class="size-4 shrink-0 fill-current group-open/sub:rotate-90 motion-safe:transition-transform motion-safe:duration-150">
                        <path fill-rule="evenodd" d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06L8.94 8 6.22 5.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                      </svg>
                      <span class="tabular-nums">{entry.children.length} subsections</span>
                    </summary>
                    <ol role="list" class="mb-1 ml-1 border-l border-stone-950/10 pl-3 dark:border-white/10">
                      {entry.children.map((child) => (
                        <li>
                          <a href={`#${child.slug}`} data-jump="" class={`${tocLink} ${tocChild}`}>{child.text}</a>
                        </li>
                      ))}
                    </ol>
                  </details>
                  <ol role="list" class="mb-1 ml-1 hidden border-l border-stone-950/10 pl-3 sm:block dark:border-white/10">
                    {entry.children.map((child) => (
                      <li>
                        <a href={`#${child.slug}`} data-jump="" class={`${tocLink} ${tocChild}`}>{child.text}</a>
                      </li>
                    ))}
                  </ol>
                </>
              )}
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )}

  <article class="prose mt-5 sm:mt-8">
    <Fragment set:html={body} />
  </article>

  <footer class="print-hide mt-14 flex items-center justify-between gap-4 border-t border-stone-950/8 pt-6 text-base/6 sm:text-sm/5 dark:border-white/8">
    <a
      href={homeHref}
      data-owner-nav="all"
      class="py-1 font-normal pointer-coarse:-my-2 pointer-coarse:inline-flex pointer-coarse:min-h-12 pointer-coarse:items-center text-stone-600 hover:text-stone-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:text-stone-400 dark:hover:text-stone-100 dark:focus-visible:outline-accent-dark"
    >
      &larr; All pages
    </a>
    <a
      href="#top"
      data-jump="report-title"
      class="ml-auto py-1 font-normal pointer-coarse:-my-2 pointer-coarse:inline-flex pointer-coarse:min-h-12 pointer-coarse:items-center text-stone-500 hover:text-stone-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:text-stone-400 dark:hover:text-stone-100 dark:focus-visible:outline-accent-dark"
    >
      Back to top &uarr;
    </a>
  </footer>
</BaseLayout>
