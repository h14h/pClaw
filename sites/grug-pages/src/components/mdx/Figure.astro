---
/**
 * A photo, chart, map, or logo saved into the page with `grug-page image`. `src` is the page-relative path it printed
 * (`img/<hash>.<ext>`). Astro resizes and re-encodes it at build time (AVIF/WebP, EXIF stripped), served from this
 * site with exact width/height so nothing shifts while it loads.
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: string;
  alt: string;
  caption?: string;
  credit?: string;
  href?: string;
}

const { src, alt, caption, credit, href } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/pages/*/img/*.{jpg,jpeg,png,webp,gif,avif}",
  { eager: true },
);
// Pages live at <base>/<slug>/, so the last path segment is this page's folder.
const slug = Astro.url.pathname.split("/").filter(Boolean).at(-1) ?? "";
const file = src.replace(/^\.?\//, "");
const image = images[`/src/content/pages/${slug}/${file}`]?.default;
if (!image) {
  throw new Error(`<Figure src="${src}">: no such image in ${slug}/. Save it with: grug-page image ${slug} <direct-image-url> --alt "..."`);
}
if (!alt || !alt.trim()) {
  throw new Error(`<Figure src="${src}"> needs alt text describing what the image shows.`);
}

const widths = [480, 800, 1200, 1600].filter((w) => w < image.width);
widths.push(Math.min(image.width, 1600));
const sizes = "(min-width: 48rem) 44rem, calc(100vw - 2.5rem)";
const imgClass =
  "block h-auto w-full rounded-lg bg-stone-100 outline -outline-offset-1 outline-stone-950/8 dark:bg-stone-900 dark:outline-white/10";
---

<figure class="not-prose my-8">
  {image.format === "gif" ? (
    <img src={image.src} width={image.width} height={image.height} alt={alt} loading="lazy" decoding="async" class={imgClass} />
  ) : (
    <Picture
      src={image}
      alt={alt}
      formats={["avif", "webp"]}
      widths={[...new Set(widths)]}
      sizes={sizes}
      loading="lazy"
      decoding="async"
      class={imgClass}
    />
  )}
  {(caption || credit) && (
    <figcaption class="mt-2.5 text-base/6 text-pretty text-stone-600 sm:text-sm/6 dark:text-stone-400">
      {caption && <span>{caption}</span>}
      {caption && credit && <span aria-hidden="true" class="px-1.5 text-stone-400 dark:text-stone-500">·</span>}
      {credit && (
        href ? (
          <a
            href={href}
            rel="noopener noreferrer"
            class="text-stone-500 underline decoration-stone-950/20 underline-offset-3 hover:text-accent hover:decoration-accent dark:text-stone-400 dark:decoration-white/20 dark:hover:text-accent-dark dark:hover:decoration-accent-dark"
          >
            {credit}
          </a>
        ) : (
          <span class="text-stone-500 dark:text-stone-400">{credit}</span>
        )
      )}
    </figcaption>
  )}
</figure>
