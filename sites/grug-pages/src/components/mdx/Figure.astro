---
/**
 * A photo, chart, map, or logo saved into the page with `grug-page image`. `src` is the page-relative path it printed
 * (`img/<hash>.<ext>`). Astro resizes and re-encodes it at build time (AVIF/WebP, EXIF stripped), served from this
 * site with exact width/height so nothing shifts while it loads.
 */
import type { ImageMetadata } from "astro";
import { Picture, getImage } from "astro:assets";

interface Props {
  src: string;
  alt: string;
  caption?: string;
  credit?: string;
  href?: string;
  /** "paper" puts a light surface behind transparent graphics with dark ink, in both themes. */
  background?: "paper";
  /** Tap or click opens the full-screen viewer (zoom, pan). `zoom={false}` for logos and other small marks. */
  zoom?: boolean;
}

const { src, alt, caption, credit, href, background, zoom = true } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/pages/*/img/*.{jpg,jpeg,png,webp,gif,avif}",
  { eager: true },
);
// Pages live at <base>/<slug>/, so the last path segment is this page's folder.
const slug = Astro.url.pathname.split("/").filter(Boolean).at(-1) ?? "";
const file = src.replace(/^\.?\//, "");
const image = images[`/src/content/pages/${slug}/${file}`]?.default;
if (!image) {
  throw new Error(`<Figure src="${src}">: no such image in ${slug}/. Save it with: grug-page image ${slug} <direct-image-url> --alt "..."`);
}
if (!alt || !alt.trim()) {
  throw new Error(`<Figure src="${src}"> needs alt text describing what the image shows.`);
}

// Portraits are capped by height (65svh, at most 34rem tall) and sit left-aligned, so the whole image and its caption
// fit on screen. Landscapes fill the column.
const ratio = image.width / image.height;
const portrait = ratio < 1;
const r = Number(ratio.toFixed(4));
// The text column: 44rem from 48rem up, 32px gutters from 40rem, 20px gutters below.
const column = ["(min-width: 48rem) 44rem", "(min-width: 40rem) calc(100vw - 4rem)", "calc(100vw - 2.5rem)"];
const fallback = portrait
  ? column.map((slot) => {
      const [, media, size] = /^(\([^)]*\) )?(.*)$/.exec(slot)!;
      return `${media ?? ""}min(${size}, ${(34 * r).toFixed(2)}rem, ${(65 * r).toFixed(2)}vh)`;
    })
  : column;
// `auto` lets supporting browsers pick for the rendered width (lazy images only); the rest is the fallback.
const sizes = ["auto", ...fallback].join(", ");

const widths = [480, 800, 1200, 1600].filter((w) => w < image.width);
widths.push(Math.min(image.width, 1600));

// The viewer's sources: the same widths as the page plus the full image (up to 4096px, so a panorama keeps its
// height), as WebP. The largest is
// also the no-JS link target, so the browser's own viewer can zoom it. URLs carry the site base, so share links
// rewrite them like every other asset.
let zoomHref = "";
let zoomSrcset = "";
if (zoom) {
  if (image.format === "gif") {
    zoomHref = image.src;
    zoomSrcset = `${image.src} ${image.width}w`;
  } else {
    const natural = Math.min(image.width, 4096);
    const zoomWidths = [...new Set([...widths, natural])].sort((a, b) => a - b);
    const full = await getImage({ src: image, widths: zoomWidths, format: "webp" });
    zoomSrcset = full.srcSet.attribute;
    zoomHref = full.srcSet.values.at(-1)?.url ?? full.src;
  }
}
const frameAttrs = zoom
  ? {
      href: zoomHref,
      class: "figure-frame figure-zoom",
      "data-zoom": "",
      "data-zoom-srcset": zoomSrcset,
      "data-zoom-w": image.width,
      "data-zoom-h": image.height,
      "aria-label": `View full size: ${alt}`,
      "data-zoom-surface": background === "paper" ? "paper" : undefined,
    }
  : { class: "figure-frame" };
const Frame = zoom ? "a" : "span";

const surface = background === "paper" ? "bg-stone-50" : "bg-stone-100 dark:bg-stone-900";
const imgClass = `block h-auto w-full rounded-[min(1vw,12px)] ${surface} outline -outline-offset-1 outline-stone-950/8 dark:outline-white/10`;
const figureStyle = portrait
  ? `--figure-ratio: ${r}; width: min(100%, calc(min(65svh, 34rem) * var(--figure-ratio)));`
  : undefined;
---

<figure class="not-prose my-8" style={figureStyle} data-portrait={portrait ? "true" : undefined}>
  <Frame {...frameAttrs}>
    {image.format === "gif" ? (
      <img src={image.src} width={image.width} height={image.height} alt={alt} loading="lazy" decoding="async" class={imgClass} />
    ) : (
      <Picture
        src={image}
        alt={alt}
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[...new Set(widths)]}
        sizes={sizes}
        loading="lazy"
        decoding="async"
        class={imgClass}
      />
    )}
    {zoom && (
      <span class="figure-zoom-icon" aria-hidden="true">
        <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9.5 2.5h4v4M13.5 2.5 9 7M6.5 13.5h-4v-4M2.5 13.5 7 9" />
        </svg>
      </span>
    )}
  </Frame>
  {(caption || credit) && (
    <figcaption class="mt-2.5 text-base/6 text-pretty text-stone-600 sm:text-sm/6 dark:text-stone-400">
      {caption && <span data-caption>{caption}</span>}
      {caption && credit && <span aria-hidden="true" class="px-1.5 text-stone-400 pointer-coarse:hidden dark:text-stone-500">·</span>}
      {credit && (
        <span class="pointer-coarse:block">
          {href ? (
            <a
              href={href}
              rel="noopener noreferrer"
              data-credit
              class="figure-credit rounded-sm text-stone-500 underline decoration-stone-950/20 underline-offset-3 hover:text-accent hover:decoration-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent pointer-coarse:inline-flex pointer-coarse:min-h-12 pointer-coarse:min-w-12 pointer-coarse:items-center dark:text-stone-400 dark:decoration-white/20 dark:hover:text-accent-dark dark:hover:decoration-accent-dark dark:focus-visible:outline-accent-dark"
            >
              {credit}
            </a>
          ) : (
            <span data-credit class="text-stone-500 dark:text-stone-400">{credit}</span>
          )}
        </span>
      )}
    </figcaption>
  )}
</figure>
