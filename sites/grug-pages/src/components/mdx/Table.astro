---
const props = Astro.props;
---

<div class="table-block my-6 flow-root">
  <p
    class="table-scroll-hint mb-1.5 items-center justify-end gap-1 font-mono text-xs tracking-wide text-stone-500 select-none dark:text-stone-400"
    aria-hidden="true"
  >
    <span>Scroll horizontally to compare</span>
    <span aria-hidden="true">&rarr;</span>
  </p>
  <div class="table-wrap relative -mx-5 sm:-mx-8">
    <div class="table-scroll -my-1 overflow-x-auto">
      <div class="table-scroll-inner inline-block min-w-full py-1 align-middle">
        <table {...props}>
          <slot />
        </table>
      </div>
    </div>
  </div>
</div>
