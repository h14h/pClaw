---
interface Props {
  checked?: string;
  title?: string;
}

const { checked, title = "Sources" } = Astro.props;
---

<footer
  id="sources"
  class="not-prose mt-12 border-t border-stone-950/10 pt-6 dark:border-white/10"
>
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-base/6 font-semibold text-stone-900 sm:text-sm/5 dark:text-zinc-100">
      {title}
    </h2>
    {checked && (
      <p class="font-mono text-sm/5 tabular-nums text-stone-500 dark:text-zinc-400">
        Checked {checked}
      </p>
    )}
  </div>
  <div class="mt-3 text-base/7 text-stone-600 sm:text-sm/6 dark:text-zinc-400 [&_ol]:list-decimal [&_ol]:space-y-1.5 [&_ol]:pl-5 [&_ul]:list-disc [&_ul]:space-y-1.5 [&_ul]:pl-5 [&_a]:text-accent [&_a]:underline [&_a]:decoration-accent/35 [&_a]:underline-offset-3 [&_a:hover]:decoration-current dark:[&_a]:text-accent-dark dark:[&_a]:decoration-accent-dark/40">
    <slot />
  </div>
</footer>
