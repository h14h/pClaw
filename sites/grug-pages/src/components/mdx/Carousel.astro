---
/**
 * A swipeable strip of `<Figure>`s: several views that explain something a single photo cannot.
 *
 *   <Carousel label="Leg 2 photos: Myrdal to Flåm">
 *     <Figure src="img/…" alt="…" caption="…" credit="…" href="…" />
 *     …
 *   </Carousel>
 *
 * Without JS the Figures simply stack, each with its caption and credit. With JS (switched on before first paint,
 * so nothing moves) they become a scroll-snap strip with prev/next buttons, a "2 / 4" counter, arrow keys, and
 * one polite announcement per settled slide. Only the settled slide shows its caption and can take focus. Every
 * slide shares one frame ratio (the median of its images), so mixed shapes never change the strip's height. One
 * Figure renders as a plain Figure.
 */
import { buildCarousel } from "../../../lib/carousel.mjs";

interface Props {
  /** What the slides show, for screen readers ("Leg 2 photos: Myrdal to Flåm"). */
  label: string;
}

const { label } = Astro.props;
if (!label || !label.trim()) {
  throw new Error('<Carousel> needs a label saying what the slides show, e.g. label="Leg 2 photos: Myrdal to Flåm".');
}

const html = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const carousel = buildCarousel(html, label);
// `grug-page build` prints the same warnings from its own lint first; a bare `astro build` prints them here.
if (carousel.kind === "carousel" && process.env.GRUG_PAGE_LINTED !== "1") {
  const slug = Astro.url.pathname.split("/").filter(Boolean).at(-1) ?? "";
  for (const warning of carousel.warnings) console.warn(`\nWARN ${slug}: ${warning}`);
}
// A 36px circle; on touch screens the button around it grows to a 48px target without the circle getting heavier.
// The focus ring hugs the visible circle, not the larger touch target.
const button =
  "group/btn inline-flex size-9 shrink-0 items-center justify-center rounded-full outline-none aria-disabled:cursor-default pointer-coarse:size-12";
const circle =
  "inline-flex size-9 items-center justify-center rounded-full group-focus-visible/btn:outline-2 group-focus-visible/btn:outline-offset-2 group-focus-visible/btn:outline-accent dark:group-focus-visible/btn:outline-accent-dark border border-stone-950/20 text-stone-700 group-hover/btn:bg-stone-950/5 group-hover/btn:text-stone-950 group-aria-disabled/btn:border-stone-950/10 group-aria-disabled/btn:bg-transparent group-aria-disabled/btn:text-stone-400 dark:border-white/25 dark:text-stone-300 dark:group-hover/btn:bg-white/8 dark:group-hover/btn:text-stone-50 dark:group-aria-disabled/btn:border-white/10 dark:group-aria-disabled/btn:text-stone-600";
---

{carousel.kind === "single" ? (
  <Fragment set:html={carousel.html} />
) : (
  <grug-carousel class="carousel not-prose my-8 block">
    {/* Runs during parsing, before the strip paints: the horizontal layout never replaces a painted stack. */}
    <script is:inline>document.currentScript.parentElement.setAttribute("data-js", "");</script>
    <section class="carousel-section" role="region" aria-roledescription="carousel" aria-label={label.trim()}>
      <div class="carousel-bar h-9 items-center justify-between gap-3 pointer-coarse:h-12">
        <p class="carousel-counter text-sm/5 tracking-normal text-stone-600 tabular-nums dark:text-stone-400" aria-hidden="true">
          <span data-carousel-counter>1 / {carousel.slides.length}</span>
        </p>
        <div class="flex items-center gap-2 pointer-coarse:-mr-1.5 pointer-coarse:gap-0">
          <button type="button" class={button} aria-label="Previous slide" aria-controls={carousel.id} aria-disabled="true" data-carousel-prev>
            <span class={circle}>
              <svg viewBox="0 0 16 16" aria-hidden="true" class="size-4 fill-current">
                <path fill-rule="evenodd" d="M9.78 4.22a.75.75 0 0 1 0 1.06L7.06 8l2.72 2.72a.75.75 0 1 1-1.06 1.06L5.47 8.53a.75.75 0 0 1 0-1.06l3.25-3.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" />
              </svg>
            </span>
          </button>
          <button type="button" class={button} aria-label="Next slide" aria-controls={carousel.id} aria-disabled="false" data-carousel-next>
            <span class={circle}>
              <svg viewBox="0 0 16 16" aria-hidden="true" class="size-4 fill-current">
                <path fill-rule="evenodd" d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06L8.94 8 6.22 5.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </span>
          </button>
        </div>
      </div>
      <div id={carousel.id} class="carousel-strip" style={`--frame: ${carousel.frame};`} role="group" aria-label="Slides" data-carousel-strip>
        {carousel.slides.map((slide, i) => (
          <div
            class="carousel-slide"
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${carousel.slides.length}`}
            data-fit={slide.fit}
            data-current={i === 0 ? "" : undefined}
            data-carousel-slide
          >
            <Fragment set:html={slide.html} />
          </div>
        ))}
      </div>
      <p class="sr-only" aria-live="polite" aria-atomic="true" data-carousel-status></p>
    </section>
  </grug-carousel>
)}

<script>
  import { createSettler } from "../../../lib/carousel.mjs";

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  class GrugCarousel extends HTMLElement {
    connectedCallback() {
      if (this.hasAttribute("data-ready")) return;
      const strip = this.querySelector<HTMLElement>("[data-carousel-strip]");
      const slides = Array.from(this.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
      const prev = this.querySelector<HTMLButtonElement>("[data-carousel-prev]");
      const next = this.querySelector<HTMLButtonElement>("[data-carousel-next]");
      const counter = this.querySelector<HTMLElement>("[data-carousel-counter]");
      const status = this.querySelector<HTMLElement>("[data-carousel-status]");
      if (!strip || slides.length < 2 || !prev || !next || !counter || !status) return;

      this.setAttribute("data-js", "");
      strip.tabIndex = 0;
      const last = slides.length - 1;
      const offset = (i: number) => slides[i].offsetLeft - slides[0].offsetLeft;
      const warm = (i: number) => {
        for (const img of slides[i]?.querySelectorAll("img") ?? []) img.loading = "eager";
      };

      // The settled slide: the one whose snap point is nearest once scrolling stops.
      const nearest = () => {
        const left = strip.scrollLeft;
        let best = 0;
        for (let i = 1; i < slides.length; i++) {
          if (Math.abs(offset(i) - left) < Math.abs(offset(best) - left)) best = i;
        }
        return best;
      };

      // One settled index drives everything: counter, buttons, the visible caption, which slide can take focus,
      // and one announcement per slide reached.
      let index = -1;
      let announced = 0;
      const apply = (i: number, announce: boolean) => {
        if (i === index) return;
        index = i;
        const active = document.activeElement;
        if (active && slides.some((slide, j) => j !== i && slide.contains(active))) strip.focus({ preventScroll: true });
        slides.forEach((slide, j) => {
          slide.toggleAttribute("data-current", j === i);
          slide.inert = j !== i;
        });
        counter.textContent = `${i + 1} / ${slides.length}`;
        prev.setAttribute("aria-disabled", String(i === 0));
        next.setAttribute("aria-disabled", String(i === last));
        if (announce && i !== announced) {
          announced = i;
          status.textContent = `Slide ${i + 1} of ${slides.length}`;
        }
        if (announce) warm(i + 1);
      };

      // Where a button or key last sent the strip, so quick repeated presses add up while it is still moving.
      let target: number | null = null;
      // scrollend where the browser has it, a quiet spell otherwise; never while a finger or pointer is down.
      const nativeScrollEnd = "onscrollend" in window;
      const settler = createSettler({
        nativeScrollEnd,
        settle: () => {
          target = null;
          apply(nearest(), true);
        },
      });
      const go = (i: number) => {
        target = Math.max(0, Math.min(last, i));
        warm(target);
        if (Math.abs(strip.scrollLeft - offset(target)) < 1) {
          target = null;
          apply(nearest(), true);
          return;
        }
        strip.scrollTo({ left: offset(target), behavior: reducedMotion.matches ? "auto" : "smooth" });
      };
      strip.addEventListener("scroll", () => settler.scroll(), { passive: true });
      if (nativeScrollEnd) strip.addEventListener("scrollend", () => settler.scrollEnd());
      strip.addEventListener("touchstart", () => settler.press(), { passive: true });
      const lift = (event: TouchEvent) => {
        if (event.touches.length === 0) settler.release();
      };
      strip.addEventListener("touchend", lift, { passive: true });
      strip.addEventListener("touchcancel", lift, { passive: true });
      // Touch pointers are covered above (their pointercancel fires as soon as the page starts panning).
      strip.addEventListener("pointerdown", (event) => {
        if (event.pointerType === "touch") return;
        settler.press();
        const up = () => {
          window.removeEventListener("pointerup", up);
          window.removeEventListener("pointercancel", up);
          settler.release();
        };
        window.addEventListener("pointerup", up);
        window.addEventListener("pointercancel", up);
      });

      const from = () => target ?? index;
      const press = (button: HTMLButtonElement, step: number) => {
        button.addEventListener("click", () => {
          if (button.getAttribute("aria-disabled") === "true") return;
          go(from() + step);
        });
      };
      press(prev, -1);
      press(next, 1);

      // Only the strip and buttons move the carousel. From a credit link inside the slide, Left/Right would scroll
      // the strip natively and pull the slide out from under the focused link, so they do nothing there.
      const onKey = (event: KeyboardEvent) => {
        if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
        if (event.target !== event.currentTarget) {
          if (event.key === "ArrowLeft" || event.key === "ArrowRight") event.preventDefault();
          return;
        }
        const to =
          event.key === "ArrowLeft" ? from() - 1
          : event.key === "ArrowRight" ? from() + 1
          : event.key === "Home" ? 0
          : event.key === "End" ? last
          : null;
        if (to === null) return;
        event.preventDefault();
        go(to);
      };
      for (const control of [strip, prev, next]) control.addEventListener("keydown", onKey);

      // Warm the first two slides once the carousel is close; after that, only the slide after the settled one.
      const near = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            warm(0);
            warm(1);
            near.disconnect();
          }
        },
        { rootMargin: "400px 0px" },
      );
      near.observe(this);

      apply(nearest(), false);
      announced = index;
      this.setAttribute("data-ready", "");
      // Caption fades start after the first paint.
      requestAnimationFrame(() => requestAnimationFrame(() => this.setAttribute("data-settled", "")));
    }
  }

  if (!customElements.get("grug-carousel")) customElements.define("grug-carousel", GrugCarousel);
</script>
