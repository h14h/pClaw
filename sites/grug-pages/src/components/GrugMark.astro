---
import { GRUG_MARK_PATH, GRUG_MARK_VIEWBOX } from "@lib/grug-mark";

interface Props {
  class?: string;
  title?: string;
}

const { class: className = "size-6", title } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={GRUG_MARK_VIEWBOX}
  fill="currentColor"
  aria-hidden={title ? undefined : "true"}
  role={title ? "img" : undefined}
  aria-label={title}
  class={className}
>
  <path fill-rule="evenodd" d={GRUG_MARK_PATH} />
</svg>
