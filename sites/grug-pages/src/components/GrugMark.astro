---
import { GRUG_MARK_FILL_PATH, GRUG_MARK_PATH, GRUG_MARK_VIEWBOX } from "@lib/grug-mark";

interface Props {
  class?: string;
  title?: string;
}

const { class: className = "size-6", title } = Astro.props;
---

<svg
  viewBox={GRUG_MARK_VIEWBOX}
  fill="none"
  aria-hidden={title ? undefined : "true"}
  role={title ? "img" : undefined}
  aria-label={title}
  class={className}
>
  <path d={GRUG_MARK_FILL_PATH} fill-rule="evenodd" class="fill-transparent dark:fill-[#d6d3d1]" />
  <path d={GRUG_MARK_PATH} fill-rule="evenodd" class="fill-[#1c1917] dark:fill-[#131416]" />
</svg>
